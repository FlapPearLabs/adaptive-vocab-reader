{
  "manifest_version": 3,
  "name": "词汇阅读助手",
  "version": "0.1.0",
  "description": "本地英文网页词汇阅读助手 —— 仅供个人 dogfood",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "https://localhost/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "https://localhost/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/dict-core.json", "data/forms.json", "data/frequency-bands.json", "data/query-dictionary.json", "data/query-forms.json"],
      "matches": ["https://*/*", "https://localhost/*"]
    }
  ],
  "action": {
    "default_title": "词汇阅读助手",
    "default_popup": "popup.html"
  }
}
