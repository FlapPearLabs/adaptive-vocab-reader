{
  "name": "adaptive-vocab-reader",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器词汇学习插件 V0.1 垂直切片",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
